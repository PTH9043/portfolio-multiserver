<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProtocolRoot>$(MSBuildThisFileDirectory)</ProtocolRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(Platform)'=='x64' And Exists('$(ProtocolRoot)build\$(Configuration)\GameProtocol.lib')">
    <ProtocolLibrary Include="$(ProtocolRoot)build\$(Configuration)\GameProtocol.lib" />
    <ProtocolLibrary Include="$(ProtocolRoot)build\vendor\protobuf\$(Configuration)\libprotobuf*.lib" Exclude="$(ProtocolRoot)build\vendor\protobuf\$(Configuration)\libprotobuf-lite*.lib" />
    <ProtocolLibrary Include="$(ProtocolRoot)build\vendor\protobuf\third_party\utf8_range\$(Configuration)\*.lib" />
    <ProtocolLibrary Include="$(ProtocolRoot)build\_deps\absl-build\absl\**\$(Configuration)\*.lib" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64' And Exists('$(ProtocolRoot)build\$(Configuration)\GameProtocol.lib')">
    <ExternalIncludePath>$(ProtocolRoot)vendor\protobuf\src;$(ProtocolRoot)build\_deps\absl-src;$(ProtocolRoot)vendor\protobuf\third_party\utf8_range;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64' And Exists('$(ProtocolRoot)build\$(Configuration)\GameProtocol.lib')">
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProtocolRoot)Generated\Cpp;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="LinkGeneratedProtocol" BeforeTargets="Link" Condition="'$(Platform)'=='x64' And Exists('$(ProtocolRoot)build\$(Configuration)\GameProtocol.lib')">
    <ItemGroup>
      <Link><AdditionalDependencies>@(ProtocolLibrary);%(Link.AdditionalDependencies)</AdditionalDependencies></Link>
    </ItemGroup>
  </Target>
  <Target Name="VerifyProtocolSchema" BeforeTargets="ClCompile" Condition="'$(Platform)'=='x64'">
    <Exec Command="python -B &quot;$(ProtocolRoot)..\tools\protocol_state.py&quot; $(Configuration)" />
  </Target>
</Project>
